<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/widget_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_liturgical_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_primary_serif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="none"
                android:fontFamily="serif"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:maxLines="8"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/widget_primary_serif_shadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="none"
                android:fontFamily="serif"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:maxLines="8"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_sans"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="none"
                android:fontFamily="sans"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:maxLines="8"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_sans_shadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="none"
                android:fontFamily="sans"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:maxLines="8"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_mono"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:maxLines="8"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_mono_shadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:maxLines="8"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="2"
            android:textColor="#DFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
