<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/widget_primary_serif"
                style="@style/ShortVerseText.Serif"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_serif_shadow"
                style="@style/ShortVerseText.Serif.Shadow"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_sans"
                style="@style/ShortVerseText.Sans"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_sans_shadow"
                style="@style/ShortVerseText.Sans.Shadow"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_mono"
                style="@style/ShortVerseText.Mono"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_primary_mono_shadow"
                style="@style/ShortVerseText.Mono.Shadow"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
